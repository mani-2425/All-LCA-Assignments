Problem Statement : Load the dataset and plot the data using line, bar, scatter plots, and heatmap with Seaborn and Matplotlib libraries.

%pip install  seaborn

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Create the dataset
data = {
    "Student": ["Amit", "Bhavna", "Chetan", "Diya", "Esha", "Farhan"],
    "Maths": [75, 82, 68, 90, 72, 85],
    "Python": [80, 78, 70, 92, 75, 88],
    "Attendance": [85, 90, 78, 95, 80, 92],
    "City": ["Pune", "Mumbai", "Pune", "Nashik", "Mumbai", "Pune"]
}

df = pd.DataFrame(data)

# Save the dataset as a CSV file
df.to_csv("sample_data_assignment_07.csv", index=False)

# Load the CSV dataset
df = pd.read_csv("sample_data_assignment_07.csv")

# Display the dataset
print("Dataset:")
print(df)

# 1. Line Plot
plt.figure(figsize=(7, 4.5))
plt.plot(df["Student"], df["Python"], marker="o")
plt.title("Python Marks of Students")
plt.xlabel("Student")
plt.ylabel("Python Marks")
plt.grid(True)
plt.tight_layout()
plt.show()

# 2. Bar Plot
plt.figure(figsize=(7, 4.5))
plt.bar(df["Student"], df["Maths"])
plt.title("Maths Marks of Students")
plt.xlabel("Student")
plt.ylabel("Maths Marks")
plt.tight_layout()
plt.show()

# 3. Scatter Plot
plt.figure(figsize=(7, 4.5))
plt.scatter(df["Maths"], df["Python"], s=70)
plt.title("Maths vs Python Marks")
plt.xlabel("Maths Marks")
plt.ylabel("Python Marks")
plt.grid(True)
plt.tight_layout()
plt.show()

# 4. Correlation Matrix
correlation = df[["Maths", "Python", "Attendance"]].corr()

print("\nCorrelation Matrix:")
print(correlation)

# 5. Heatmap
plt.figure(figsize=(6.5, 5))
sns.heatmap(
    correlation,
    annot=True,
    cmap="Blues",
    vmin=-1,
    vmax=1
)
plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()
