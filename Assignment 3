def check_right_angled_triangle(a, b, c):
    if a*a + b*b == c*c or a*a + c*c == b*b or b*b + c*c == a*a:
        return "Right-angled triangle"
    else:
        return "Not a right-angled triangle"
        
side1 = float(input("Enter side 1: "))
