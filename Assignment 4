# Matrix addition using list

matrix1 = [[1,2],
            [3,4]]
matrix2 = [[5,6],
            [7,8]]
result = [[0,0],
          [0,0]]
for i in range (2):
    for j in range (2):
        result[i][j] = matrix1 [i][j] + matrix2 [i][j]
print("Addition of matrices using List:")
for row in result:
    print(row)

#Matrix addition using NumPy:

import numpy as np
matrix1 = np.array([[1,2],
                    [3,4]])
matrix2 = np.array([[5,6],
                    [7,8]])
result = matrix1 + matrix2
print("\n Addition of matrices using Numpy:")
print (result)
